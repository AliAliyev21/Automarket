{
  "permissions": {
    "allow": [
      "Bash(dotnet new:*)", "Bash(dotnet sln:*)", "Bash(dotnet add:*)",
      "Bash(dotnet build:*)", "Bash(dotnet test:*)", "Bash(dotnet ef:*)",
      "Bash(dotnet format:*)", "Bash(dotnet restore:*)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)",
      "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git branch:*)",
      "Bash(git merge:*)", "Bash(git rebase:*)", "Bash(git reset:*)",
      "Bash(git restore:*)", "Bash(git stash:*)", "Bash(git tag:*)",
      "Bash(gh:*)", "Bash(glab:*)",
      "Read(./.env)", "Read(./.env.*)", "Read(./**/appsettings.Production.json)"
    ]
  }
}
