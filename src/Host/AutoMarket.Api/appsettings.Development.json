{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Npgsql": "Information",
        "StackExchange.Redis": "Warning",
        "System": "Warning"
      }
    }
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173" ]
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None"
  },
  "Notifications": {
    "Links": {
      "ConfirmEmailUrl": "https://localhost:5173/confirm-email",
      "ResetPasswordUrl": "https://localhost:5173/reset-password"
    }
  }
}
