# docker-compose.yml üçün nümunə dəyişənlər (ARCHITECTURE §11).
# İstifadə: cp .env.example .env, sonra bütün change-me-* dəyərlərini öz parollarınızla əvəz edin.
# .env gitignored-dur və repoya düşmür (SEC-SEC-01). Bu faylda real secret olmamalıdır.
# Eyni parollar API üçün user-secrets-ə yazılır (README: "Lokal mühiti işə salmaq").
# change-me dəyərləri API-nin startup yoxlaması (ValidateOnStart) tərəfindən rədd edilir.

# PostgreSQL istifadəçi adı (database: automarket)
POSTGRES_USER=automarket

# PostgreSQL parolu. Volume ilk dəfə yaradılanda yazılır; dəyişəndə docker compose down -v lazımdır
POSTGRES_PASSWORD=change-me-postgres

# PostgreSQL-in host portu (optional, default 5432). Kompüterdə lokal PostgreSQL varsa, məs. 5433
POSTGRES_PORT=5432

# Redis parolu (redis-server --requirepass)
REDIS_PASSWORD=change-me-redis

# RabbitMQ istifadəçi adı (Management UI: http://localhost:15672)
RABBITMQ_USER=automarket

# RabbitMQ parolu
RABBITMQ_PASSWORD=change-me-rabbitmq

# Seq admin parolu (UI: http://localhost:5341, istifadəçi admin). Yalnız ilk işə salmada tətbiq olunur
SEQ_ADMIN_PASSWORD=change-me-seq
